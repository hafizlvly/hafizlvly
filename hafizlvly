<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Website Pribadiku</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0b1120;
      color: white;
      text-align: center;
    }
    .profile {
      padding: 70px 20px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .avatar {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: #164e63;
      border: 3px solid #22d3ee;
      display: grid;
      place-items: center;
      font-size: 44px;
      margin-bottom: 20px;
    }
    h1 { margin: 8px; color: #67e8f9; }
    p { color: #cbd5e1; line-height: 1.7; }
    .link {
      display: block;
      width: 250px;
      max-width: 100%;
      margin: 10px;
      padding: 14px;
      background: #172554;
      border: 1px solid #22d3ee;
      border-radius: 12px;
      color: white;
      text-decoration: none;
    }
    .link:hover { background: #164e63; }
    footer { color: #94a3b8; margin-top: 30px; font-size: 12px; }
  </style>
</head>
<body>
  <main class="profile">
    <div class="avatar">👤</div>

    <h1>Hafiz Gallagher</h1>
    <p>
      Selamat datang di website pribadiku!<br>
      Aku sedang belajar membuat website.
    </p>

    <a class="link" href="https://instagram.com/hafizlvly">
      Instagram
    </a>

    <a class="link" href="https://wa.me/6285742446821">
      WhatsApp
    </a>

    <a class="link" href="https://github.com/hafizlvly">
      GitHub
    </a>

    <footer>© 2026 Website Pribadiku</footer>
  </main>
</body>
</html>
